#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        // Column 7 (the &kp UP / DOWN / LEFT / RIGHT / ENTER entries in the
        // middle of each row) is the 5-way joystick below the right OLED.
        base {
            display-name = "Base";
            bindings = <
&kp ESC     &kp N1    &kp N2  &kp N3    &kp N4  &kp N5       &kp UP     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
&kp TAB     &kp Q     &kp W   &kp E     &kp R   &kp T        &kp DOWN   &kp Y      &kp U      &kp I      &kp O      &kp P      &kp GRAVE
&kp LSHFT   &kp A     &kp S   &kp D     &kp F   &kp G        &kp LEFT   &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LCTRL   &kp Z     &kp X   &kp C     &kp V   &kp B        &kp RIGHT  &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp BSLH
&kp C_MUTE  &kp LALT  &mo 1   &kp LGUI  &mo 1   &kp SPACE    &kp ENTER  &kp SPACE  &kp ENTER  &kp MINUS  &kp EQUAL  &kp RSHFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn {
            display-name = "Fn";
            bindings = <
&mo 2     &kp F1   &kp F2   &kp F3  &kp F4  &kp F5    &kp PG_UP  &kp F6  &kp F7  &kp F8  &kp F9      &kp F10   &kp DEL
&trans    &kp F11  &kp F12  &trans  &trans  &trans    &kp PG_DN  &trans  &trans  &trans  &trans      &trans    &kp LBKT
&kp CAPS  &trans   &trans   &trans  &trans  &trans    &kp HOME   &trans  &trans  &trans  &trans      &trans    &kp RBKT
&trans    &trans   &trans   &trans  &trans  &trans    &kp END    &trans  &trans  &trans  &trans      &kp INS   &kp PSCRN
&trans    &trans   &trans   &trans  &trans  &trans    &trans     &trans  &trans  &kp C_PREV  &kp C_PP  &kp C_NEXT
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        settings {
            display-name = "Settings";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &none      &none
&none   &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none           &none  &bl BL_TOG       &bl BL_INC       &bl BL_DEC       &none            &none      &none
&none   &out OUT_USB  &out OUT_BLE    &none         &none         &none           &none  &none            &none            &none            &none            &none      &none
&none   &none         &none           &none         &none         &none           &none  &none            &none            &none            &none            &none      &none
&trans  &none         &trans          &none         &trans        &none           &none  &none            &none            &bootloader      &sys_reset       &soft_off
            >;
        };
    };
};
